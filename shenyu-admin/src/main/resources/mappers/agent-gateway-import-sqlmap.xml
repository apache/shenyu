<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.shenyu.admin.mapper.AgentGatewayImportMapper">

    <resultMap id="BaseResultMap" type="org.apache.shenyu.admin.model.entity.AgentGatewayImportDO">
        <id column="id" jdbcType="VARCHAR" property="id"/>
        <result column="rule_id" jdbcType="VARCHAR" property="ruleId"/>
        <result column="namespace_id" jdbcType="VARCHAR" property="namespaceId"/>
        <result column="manifest" jdbcType="LONGVARCHAR" property="manifest"/>
        <result column="date_created" jdbcType="TIMESTAMP" property="dateCreated"/>
        <result column="date_updated" jdbcType="TIMESTAMP" property="dateUpdated"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, rule_id, namespace_id, manifest, date_created, date_updated
    </sql>

    <!-- Oracle binds the manifest as a CLOB so large values are not truncated as CHAR parameters. -->
    <sql id="Manifest_Value">
        <choose>
            <when test="_databaseId == 'oracle'">
                #{manifest, jdbcType=CLOB, typeHandler=org.apache.shenyu.admin.mybatis.oracle.OracleClobStringTypeHandler}
            </when>
            <otherwise>
                #{manifest, jdbcType=LONGVARCHAR}
            </otherwise>
        </choose>
    </sql>

    <select id="selectByRuleId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_gateway_import
        WHERE rule_id = #{ruleId, jdbcType=VARCHAR}
          AND namespace_id = #{namespaceId, jdbcType=VARCHAR}
    </select>

    <insert id="insertSelective" parameterType="org.apache.shenyu.admin.model.entity.AgentGatewayImportDO">
        INSERT INTO agent_gateway_import (
            id,
            rule_id,
            namespace_id,
            manifest,
            date_created,
            date_updated
        ) VALUES (
            #{id, jdbcType=VARCHAR},
            #{ruleId, jdbcType=VARCHAR},
            #{namespaceId, jdbcType=VARCHAR},
            <include refid="Manifest_Value"/>,
            #{dateCreated, jdbcType=TIMESTAMP},
            #{dateUpdated, jdbcType=TIMESTAMP}
        )
    </insert>

    <update id="updateManifestById">
        UPDATE agent_gateway_import
           SET manifest = <include refid="Manifest_Value"/>,
               date_updated = #{dateUpdated, jdbcType=TIMESTAMP}
         WHERE id = #{id, jdbcType=VARCHAR}
    </update>

    <delete id="deleteByRuleId">
        DELETE FROM agent_gateway_import
         WHERE rule_id = #{ruleId, jdbcType=VARCHAR}
           AND namespace_id = #{namespaceId, jdbcType=VARCHAR}
    </delete>
</mapper>
