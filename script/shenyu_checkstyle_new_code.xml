<!--
  Stricter rules applied only to lines that a pull request adds under src/main.
  .github/scripts/check-new-code-quality.py runs this configuration on the changed
  files and keeps only the violations reported on added lines, so existing code is
  not affected. script/shenyu_checkstyle.xml remains the build-wide configuration.
  Rule IDs (Q1..Q6) match the "Code quality rules" section of AGENTS.md.
  Keep every module compatible with Checkstyle 9.3, the version used by
  maven-checkstyle-plugin 3.4.0.
-->
<!DOCTYPE module PUBLIC "-//Puppy Crawl//DTD Check Configuration 1.3//EN" "http://checkstyle.sourceforge.net/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Q1: name numeric literals; field declarations hold the named constants -->
        <module name="MagicNumber">
            <property name="id" value="Q1"/>
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
            <message key="magic.number"
                     value="[Q1] ''{0}'' is a magic number. Reuse an existing constant or declare a named constant with its unit."/>
        </module>
        <!--
          MagicNumber treats every final variable as a constant definition, including the
          final local variables used throughout ShenYu. Report numeric literals inside
          local final declarations separately.
        -->
        <module name="MatchXpath">
            <property name="id" value="Q1"/>
            <property name="query" value="//SLIST//VARIABLE_DEF[./MODIFIERS/FINAL]//*[self::NUM_INT or self::NUM_LONG or self::NUM_FLOAT or self::NUM_DOUBLE][not(matches(@text, '^(0|1|2)(\.0*)?[lLfFdD]?$'))][not(ancestor::ANNOTATION)]"/>
            <message key="matchxpath.match"
                     value="[Q1] Numeric literal in a local final variable. Reuse an existing constant or declare a named constant with its unit."/>
        </module>
        <!-- Q2: repeated string literals such as header names or configuration keys -->
        <module name="MultipleStringLiterals">
            <property name="id" value="Q2"/>
            <property name="allowedDuplicates" value="2"/>
            <property name="ignoreStringsRegexp" value='^(""|", "|",")$'/>
            <message key="multiple.string.literal"
                     value="[Q2] The string {0} appears {1} times in this file. Extract it into a constant."/>
        </module>
        <!-- Q3: keep new methods small enough to read in one pass -->
        <module name="MethodLength">
            <property name="id" value="Q3"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
            <property name="max" value="50"/>
            <property name="countEmpty" value="false"/>
            <message key="maxLen.method"
                     value="[Q3] Method length is {0} lines (max allowed for new code is {1}). Split it into focused methods."/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="id" value="Q3"/>
            <property name="max" value="10"/>
            <property name="switchBlockAsSingleDecisionPoint" value="true"/>
            <message key="cyclomaticComplexity"
                     value="[Q3] Cyclomatic complexity is {0} (max allowed for new code is {1}). Extract branches into methods."/>
        </module>
        <module name="NPathComplexity">
            <property name="id" value="Q3"/>
            <property name="max" value="200"/>
            <message key="npathComplexity"
                     value="[Q3] NPath complexity is {0} (max allowed for new code is {1}). Extract branches into methods."/>
        </module>
        <!-- Q4: shallow control flow; max 2 allows three levels of nested if -->
        <module name="NestedIfDepth">
            <property name="id" value="Q4"/>
            <property name="max" value="2"/>
            <message key="nested.if.depth"
                     value="[Q4] Nested if-else depth is {0} (max allowed for new code is {1}). Use early returns or extract a method."/>
        </module>
        <module name="BooleanExpressionComplexity">
            <property name="id" value="Q4"/>
            <property name="max" value="3"/>
            <message key="booleanExpressionComplexity"
                     value="[Q4] Boolean expression complexity is {0} (max allowed is {1}). Extract named conditions."/>
        </module>
        <!-- Q5: small parameter lists -->
        <module name="ParameterNumber">
            <property name="id" value="Q5"/>
            <property name="max" value="5"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="tokens" value="METHOD_DEF"/>
            <message key="maxParam"
                     value="[Q5] More than {0} parameters (found {1}). Group related parameters into a value object."/>
        </module>
        <!-- Q6: TODO and FIXME comments must reference an issue -->
        <module name="TodoComment">
            <property name="id" value="Q6"/>
            <property name="format" value="(?i)\b(TODO|FIXME)\b(?!.*#\d+)"/>
            <message key="todo.match"
                     value="[Q6] TODO/FIXME without an issue reference. Add the issue number, for example TODO(#1234)."/>
        </module>
    </module>
</module>
